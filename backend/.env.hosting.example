# Temporary HTTP test deployment
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=azadgozar.ir,www.azadgozar.ir,212.23.216.121
CSRF_TRUSTED_ORIGINS=http://azadgozar.ir,http://www.azadgozar.ir
CORS_ALLOWED_ORIGINS=http://azadgozar.ir,http://www.azadgozar.ir

# Test-only local database. Switch to PostgreSQL before the public launch.
DATABASE_ENGINE=sqlite
SQLITE_PATH=/home/fupyqsxy/azadgozar_app/db.sqlite3

# Shared hosting without Redis/Celery
CELERY_ENABLED=0
DJANGO_SERVE_MEDIA=1

# Private test only: OTP codes are written to the application log.
# Set this back to 0 before public launch and configure a real SMS provider.
OTP_CONSOLE_MODE=1
